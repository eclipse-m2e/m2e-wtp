<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.eclipse.m2e.wtp</groupId>
		<artifactId>org.eclipse.m2e.wtp.parent</artifactId>
		<version>1.6.2-SNAPSHOT</version>
		<relativePath>../..</relativePath>
	</parent>

	<artifactId>org.eclipse.m2e.wtp.promotion</artifactId>

	<packaging>pom</packaging>

	<name>M2E-WTP :: Promotion</name>

	<properties>
		<eclipse.repo>https://download.eclipse.org/releases/latest</eclipse.repo>
		<justj.tools.repo>https://download.eclipse.org/justj/tools/updates/nightly/latest</justj.tools.repo>
		<org.eclipse.storage.user>genie.m2e</org.eclipse.storage.user>
		<org.eclipse.justj.p2.manager.args>-remote ${org.eclipse.storage.user}@projects-storage.eclipse.org:/home/data/httpd/download.eclipse.org/tools/orbit</org.eclipse.justj.p2.manager.args>
		<org.eclipse.justj.p2.manager.extra.args></org.eclipse.justj.p2.manager.extra.args>
		<org.eclipse.justj.p2.manager.relative>updates</org.eclipse.justj.p2.manager.relative>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<org.eclipse.justj.p2.manager.build.url>http://www.example.com/</org.eclipse.justj.p2.manager.build.url>
		<build.type>nightly</build.type>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-eclipse-plugin</artifactId>
				<version>${tycho-version}</version>
				<configuration>
					<executionEnvironment>JavaSE-21</executionEnvironment>
					<dependencies>
						<dependency>
							<artifactId>org.eclipse.justj.p2</artifactId>
							<type>eclipse-plugin</type>
						</dependency>
						<dependency>
							<artifactId>org.eclipse.ecf.provider.filetransfer.httpclient5</artifactId>
							<type>eclipse-plugin</type>
						</dependency>
						<dependency>
							<artifactId>org.apache.felix.scr</artifactId>
							<type>eclipse-plugin</type>
						</dependency>
					</dependencies>
					<repositories>
						<repository>
							<id>eclipse.repo</id>
							<layout>p2</layout>
							<url>${eclipse.repo}</url>
						</repository>
						<repository>
							<id>justj.tools.repo</id>
							<layout>p2</layout>
							<url>${justj.tools.repo}</url>
						</repository>
					</repositories>
				</configuration>
				<executions>
					<execution>
						<id>promote</id>
						<goals>
							<goal>eclipse-run</goal>
						</goals>
						<phase>generate-sources</phase>
						<configuration>
							<argLine></argLine>
							<appArgLine>
                              <![CDATA[
                                -consoleLog
                                -application org.eclipse.justj.p2.manager
                                -data @None
                                -nosplash
                                ${org.eclipse.justj.p2.manager.args}
                                -retain 5
                                -label "m2e Web Tools Platform Integration"
                                -build-url ${org.eclipse.justj.p2.manager.build.url}
                                -root ${project.basedir}/m2e-wtp
                                -relative ${org.eclipse.justj.p2.manager.relative}
                                -version-iu org.eclipse.m2e.wtp.sdk.feature.feature.group
                                -commit https://github.com/eclipse-m2e/m2e-wtp/commit/${git.commit}
                                -target-url https://download.eclipse.org/technology/m2e/m2e-wtp
                                -promote ${project.basedir}/../target/repository
                                -timestamp ${build.timestamp}
                                -type ${build.type}
                                -breadcrumb "m2e&nbsp;WTP https://projects.eclipse.org/projects/technology.m2e"
                                -mapping m2e-wtp->m2e-WTP
                                -favicon https://raw.githubusercontent.com/eclipse-m2e/m2e-wtp/refs/heads/master/org.eclipse.m2e.wtp/m2e-wtp_icon_32px.png
                                -body-image https://raw.githubusercontent.com/eclipse-m2e/m2e-wtp/refs/heads/master/org.eclipse.m2e.wtp/m2e-wtp_icon_32px.png
                                -title-image https://raw.githubusercontent.com/eclipse-m2e/m2e-wtp/refs/heads/master/org.eclipse.m2e.wtp/m2e-wtp_icon_32px.png
                                -bree
                                ${org.eclipse.justj.p2.manager.extra.args}
                              ]]>
                          </appArgLine>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
